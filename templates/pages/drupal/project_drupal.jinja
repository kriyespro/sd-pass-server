{% extends "base.jinja" %}
{% block title %}Drupal — {{ project.name }}{% endblock %}
{% block content %}
<section class="mx-auto max-w-3xl space-y-6">
  <p class="text-sm text-slate-400">
    <a href="{{ url('projects:dashboard') }}" class="font-medium text-emerald-400 hover:text-emerald-300">← Projects</a>
    · <span class="text-slate-300">{{ project.name }}</span>
  </p>

  <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
    <h1 class="text-xl font-semibold text-white">Drupal</h1>
    <p class="mt-2 text-sm text-slate-400">
      To import an existing Drupal codebase instead of the scaffolded site, use the <a href="{{ url('projects:upload_zip', slug=project.slug) }}" class="text-emerald-400 hover:text-emerald-300">ZIP upload</a> page — every upload replaces the previous build.
    </p>

    {% if not drupal_instance %}
      <p class="mt-4 rounded-xl border border-dashed border-slate-700 bg-slate-950/40 px-4 py-6 text-center text-sm text-slate-500">
        Your Drupal site is still being set up (Composer scaffold can take a couple of minutes). This page will show admin details once it is ready — refresh in a moment.
      </p>
    {% else %}
      <dl class="mt-4 divide-y divide-slate-800 rounded-xl border border-slate-800 text-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Site</dt>
          <dd>
            <a href="{{ site_url }}" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-sky-300 hover:text-sky-200">{{ site_url }}</a>
          </dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Admin login</dt>
          <dd>
            <a href="{{ site_url }}user/login" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-sky-300 hover:text-sky-200">{{ site_url }}user/login</a>
          </dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Container status</dt>
          <dd>
            {% if is_running %}
              <span class="inline-flex rounded-full bg-emerald-500/15 px-1.5 py-px text-[9px] font-semibold text-emerald-300 ring-1 ring-emerald-500/30">Running</span>
            {% else %}
              <span class="inline-flex rounded-full bg-slate-800 px-1.5 py-px text-[9px] font-semibold text-slate-300">Not running</span>
            {% endif %}
          </dd>
        </div>
        {% if stats.status == 'running' %}
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Resource usage</dt>
          <dd class="font-mono text-xs text-white">{{ stats.mem_usage_mb }} / {{ stats.mem_limit_mb }} MB · {{ stats.cpu_percent }}% CPU</dd>
        </div>
        {% endif %}
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Site name</dt>
          <dd class="font-mono text-xs text-white">{{ drupal_instance.site_name or project.name }}</dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Admin username</dt>
          <dd class="font-mono text-xs text-white">{{ drupal_instance.admin_user }}</dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Admin email</dt>
          <dd class="font-mono text-xs text-white">{{ drupal_instance.admin_email }}</dd>
        </div>
        {% if not drupal_instance.admin_pass_enc %}
        <div class="px-4 py-3 text-xs text-amber-300">
          This site's Drupal login was already configured in the uploaded codebase — the platform never ran the installer and does not know its password.
        </div>
        {% endif %}
        {% if db %}
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <dt class="text-slate-400">Database</dt>
          <dd class="font-mono text-xs text-white">{{ db.name }} ({{ db.get_engine_display() }}) · user {{ db.username }}</dd>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3" x-data="{ shown: false }">
          <dt class="text-slate-400">Database password</dt>
          <dd>
            <template x-if="!shown">
              <button type="button"
                      class="text-xs font-semibold text-amber-300 hover:text-amber-200"
                      hx-post="{{ url('projects:drupal_db_reveal', slug=project.slug) }}"
                      hx-target="next span"
                      hx-swap="innerHTML"
                      @htmx:after-request="shown = true">
                Reveal
              </button>
            </template>
            <span></span>
          </dd>
        </div>
        {% endif %}
      </dl>
    {% endif %}
  </div>
</section>
{% endblock %}
