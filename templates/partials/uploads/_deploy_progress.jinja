{% if state == 'progress' %}
<div
  hx-get="{{ url('projects:upload_status_partial', slug=project.slug, upload_id=upload.pk) }}"
  hx-trigger="load delay:1.5s"
  hx-target="this"
  hx-swap="outerHTML"
>
  <div class="flex items-center justify-between text-sm">
    <span class="font-medium text-slate-200">{{ label }}</span>
    <span class="font-mono text-emerald-300">{{ percent }}%</span>
  </div>
  <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-slate-800">
    <div
      class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-emerald-400 transition-all duration-700 ease-out"
      style="width: {{ percent }}%"
    >
      <div class="h-full w-full animate-pulse bg-white/20"></div>
    </div>
  </div>
  <p class="mt-3 flex items-center gap-1.5 text-xs text-slate-500">
    <span class="h-1.5 w-1.5 animate-ping rounded-full bg-emerald-400"></span>
    Checking again in a moment…
  </p>
</div>
{% elif state == 'success' %}
<div class="rounded-xl border border-emerald-700/50 bg-emerald-950/30 px-4 py-4">
  <div class="flex items-center justify-between text-sm">
    <span class="font-semibold text-emerald-200">✅ {{ label }}</span>
    <span class="font-mono text-emerald-300">100%</span>
  </div>
  <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-slate-800">
    <div class="h-full rounded-full bg-emerald-500" style="width: 100%"></div>
  </div>
  <div class="mt-3 flex flex-wrap gap-3 text-xs">
    <a href="{{ url('projects:dashboard') }}" class="text-emerald-300 underline hover:text-emerald-200">← Back to projects</a>
    <a href="{{ url('projects:logs', slug=project.slug) }}" class="text-slate-400 underline hover:text-white">View logs</a>
  </div>
</div>
{% else %}
<div class="rounded-xl border border-rose-700/50 bg-rose-950/20 px-4 py-4">
  <div class="flex items-center justify-between text-sm">
    <span class="font-semibold text-rose-200">❌ {{ label }}</span>
    <span class="font-mono text-rose-300">100%</span>
  </div>
  <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-slate-800">
    <div class="h-full rounded-full bg-rose-500" style="width: 100%"></div>
  </div>
  <a href="{{ url('projects:logs', slug=project.slug) }}" class="mt-3 inline-block text-xs text-rose-300 underline hover:text-rose-200">View logs for details</a>
</div>
{% endif %}
