{% extends "base.jinja" %}
{% block title %}PHP — {{ project.name }}{% endblock %}
{% block content %}
<section class="mx-auto max-w-3xl space-y-6">
  <p class="text-sm text-slate-400">
    <a href="{{ url('projects:dashboard') }}" class="font-medium text-emerald-400 hover:text-emerald-300">← Projects</a>
    · <span class="text-slate-300">{{ project.name }}</span>
  </p>

  <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
    <h1 class="text-xl font-semibold text-white">PHP app</h1>
    <p class="mt-2 text-sm text-slate-400">
      Deploy or redeploy from the <a href="{{ url('projects:upload_zip', slug=project.slug) }}" class="text-emerald-400 hover:text-emerald-300">ZIP upload</a> page — every upload replaces the previous build.
    </p>

    <dl class="mt-4 divide-y divide-slate-800 rounded-xl border border-slate-800 text-sm" hx-trigger="every 10s" hx-get="{{ url('projects:php', slug=project.slug) }}" hx-select="dl > *" hx-swap="innerHTML" id="php-status-dl">
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <dt class="text-slate-400">Site</dt>
        <dd>
          <a href="{{ site_url }}" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-sky-300 hover:text-sky-200">{{ site_url }}</a>
        </dd>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <dt class="text-slate-400">Container status</dt>
        <dd>
          {% if is_running %}
            <span class="inline-flex rounded-full bg-emerald-500/15 px-1.5 py-px text-[9px] font-semibold text-emerald-300 ring-1 ring-emerald-500/30">Running</span>
          {% else %}
            <span class="inline-flex rounded-full bg-slate-800 px-1.5 py-px text-[9px] font-semibold text-slate-300">Not running</span>
          {% endif %}
        </dd>
      </div>
      {% if stats.status == 'running' %}
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <dt class="text-slate-400">Resource usage</dt>
        <dd class="font-mono text-xs text-white">{{ stats.mem_usage_mb }} / {{ stats.mem_limit_mb }} MB · {{ stats.cpu_percent }}% CPU</dd>
      </div>
      {% endif %}
      {% if db %}
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <dt class="text-slate-400">Database</dt>
        <dd class="font-mono text-xs text-white">{{ db.name }} ({{ db.get_engine_display() }}) · user {{ db.username }}</dd>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3" x-data="{ shown: false, pass: '' }">
        <dt class="text-slate-400">Database password</dt>
        <dd>
          <template x-if="!shown">
            <button type="button"
                    class="text-xs font-semibold text-amber-300 hover:text-amber-200"
                    hx-post="{{ url('projects:php_db_reveal', slug=project.slug) }}"
                    hx-target="next span"
                    hx-swap="innerHTML"
                    @htmx:after-request="shown = true">
              Reveal
            </button>
          </template>
          <span></span>
        </dd>
      </div>
      {% endif %}
    </dl>
  </div>
</section>
{% endblock %}
